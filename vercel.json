{
  "buildCommand": "",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/topic_:slug", "destination": "/topic.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
